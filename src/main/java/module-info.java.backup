module com.example.project {
    requires javafx.controls;
    requires javafx.fxml;
    requires javafx.web;

    requires org.controlsfx.controls;
    requires com.dlsc.formsfx;
    requires net.synedra.validatorfx;
    requires org.kordamp.ikonli.javafx;
    requires org.kordamp.bootstrapfx.core;
    requires eu.hansolo.tilesfx;
    requires com.almasb.fxgl.all;
    requires javafx.base;
    requires java.sql;
    requires com.microsoft.sqlserver.jdbc;
    requires com.fasterxml.jackson.databind;
    
    // JPA / Hibernate
    requires jakarta.persistence;
    requires jakarta.transaction;
    requires java.naming;
    requires jakarta.cdi;
    // Hibernate se carga como módulo automático, no necesita requires explícito

    opens com.example.project to javafx.fxml;
    // Abrir entidades para reflexión de JPA/Hibernate (necesario para proxies y lazy loading)
    opens com.example.project.entities;
    opens com.example.project.repositories;
    opens com.example.project.jpa;
    
    exports com.example.project;
    exports com.example.project.entities;
    exports com.example.project.repositories;
    exports com.example.project.jpa;
}

